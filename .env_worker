# =============================================================================
# DeepSight Worker 环境配置模板（编解码 + 调 Triton）
#
# 用法：复制/重命名为 .env 后再启动（程序只加载 .env）
#   python -m app.worker_main
#
# 说明：
# - 本文件仅作模板，不会被自动加载
# - 标了【需与 API 一致】的项，与 API 机 .env 取值要相同
# =============================================================================

# ---------- 日志 ----------
DEBUG=false
LOG_LEVEL=INFO

# ---------- Worker 服务（本机监听）----------
WORKER_HOST=0.0.0.0
WORKER_PORT=8100
# 【需与 API 一致】API 调 Worker 内部接口的密钥；两边留空则不校验
WORKER_TOKEN=change-me

# Worker 机一般不需要配置 WORKER_NODES / DEFAULT_WORKER_ID
#（那些是 API 机用来发现本机的）
# WORKER_NODES=local|本机|local
# DEFAULT_WORKER_ID=local
# WORKER_HTTP_TIMEOUT=30

# ---------- Triton（本机或同机房推理地址）----------
# 本机 Docker 映射示例：宿主机 8201 -> 容器 8001 时写 127.0.0.1:8201
TRITON_URL=10.1.3.21:8201

# ---------- ZLMediaKit【需与 API 一致或 Worker 能访问】----------
ZLM_HOST=10.1.3.21
ZLM_RTMP_PORT=1935
ZLM_RTSP_PORT=8554
ZLM_HTTP_PORT=8080
ZLM_SECRET=b1CXeSHhB1AcYV5Hmf9e9h7nyHXsI9Tm
ZLM_DEFAULT_VHOST=__defaultVhost__
ZLM_RECORD_WAIT_BUFFER_MS=2000

# ---------- 视频推流默认参数 ----------
DEFAULT_OUTPUT_FORMAT=rtmp
DEFAULT_OUT_FPS=15
DEFAULT_ALARM_INTERVAL=1
DEFAULT_SCENE_ID=scene_001
DEFAULT_SKILL_NAME=person_count_detector26
DEFAULT_TEST_VIDEO=test_images_videos/person_gouzi.mp4
STREAM_QUEUE_SIZE=4
STREAM_USE_HARDWARE_ENCODING=true
STREAM_USE_HARDWARE_DECODING=true
STREAM_BITRATE=2M
STREAM_BUFFER_SIZE=2M
STREAM_RECONNECT_DELAY=2.0

# ---------- MySQL【需与 API 一致】告警落库 ----------
MYSQL_HOST=10.1.3.21
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=yingjiting

# ---------- Redis（可选；Worker 侧缓存用得少）----------
REDIS_HOST=10.1.3.21
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_ENABLED=true

# ---------- MinIO【需与 API 一致】告警截图上传 ----------
MINIO_ENDPOINT=10.1.3.21:9000
MINIO_CONSOLE_URL=http://10.1.3.21:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=yingjiting
MINIO_SECURE=false
MINIO_PUBLIC_READ=true
# MINIO_PUBLIC_BASE_URL=

# ---------- 告警回写 / 人数上传（按业务需要）----------
COAL_ALARM_UPDATE_URL=http://192.168.26.224:9710/coal/alarm/update
COAL_ALARM_UPDATE_TIMEOUT=10
COUNTING_RECOG_UPLOAD_URL=http://192.168.26.224:9810/mine/countingRecog/upload
COUNTING_RECOG_UPLOAD_TIMEOUT=10
COUNTING_RECOG_MINE_CODE=
COUNTING_RECOG_CAMERA_CODE=

# ---------- 本项目 RabbitMQ（Webhook；Worker 上可不启消费，入队需能连）----------
RABBITMQ_HOST=10.1.3.21
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
RABBITMQ_TIMEOUT=5
RABBITMQ_WEBHOOK_ENABLED=true
RABBITMQ_WEBHOOK_EXCHANGE=alerts.webhook
RABBITMQ_WEBHOOK_QUEUE=alerts.webhook.deliver
RABBITMQ_WEBHOOK_ROUTING_KEY=webhook.deliver
RABBITMQ_WEBHOOK_QUEUE_MAX_LENGTH=10000
RABBITMQ_WEBHOOK_MESSAGE_TTL_MS=86400000
RABBITMQ_WEBHOOK_PREFETCH=4
RABBITMQ_WEBHOOK_MAX_RETRY=3
WEBHOOK_TIMEOUT=5

# ---------- 外部平台 RabbitMQ（过线人数等）----------
EXTERNAL_RABBITMQ_HOST=172.16.201.80
EXTERNAL_RABBITMQ_PORT=5672
EXTERNAL_RABBITMQ_USERNAME=ruoyi
EXTERNAL_RABBITMQ_PASSWORD=ruoyi123
EXTERNAL_RABBITMQ_VHOST=/
EXTERNAL_RABBITMQ_EXCHANGE=mine.data.push
EXTERNAL_RABBITMQ_ROUTING_KEY=mine.undergroundCount
EXTERNAL_RABBITMQ_TIMEOUT=5

# ---------- JWT（Worker 通常不用登录，可与 API 保持一致）----------
JWT_SECRET_KEY=yingjiting-change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=Admin@123

# ---------- 前端（Worker 不托管前端，可忽略）----------
# FRONTEND_DIST_DIR=frontend/dist
# REST_HOST=127.0.0.1
# REST_PORT=8000
