# DeepSight API + 前端（CPU 机）
# build context: 仓库根目录
FROM node:20-bookworm-slim AS frontend-build
ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm config set registry "${NPM_REGISTRY}" \
    && npm install
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim-bookworm AS runtime
ARG DEBIAN_MIRROR=https://mirrors.aliyun.com
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/lib/aarch64-linux-gnu

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i \
        -e "s|https\?://deb.debian.org/debian|${DEBIAN_MIRROR}/debian|g" \
        -e "s|https\?://security.debian.org/debian-security|${DEBIAN_MIRROR}/debian-security|g" \
        /etc/apt/sources.list.d/debian.sources; \
    else \
      printf '%s\n' \
        "deb ${DEBIAN_MIRROR}/debian bookworm main contrib non-free non-free-firmware" \
        "deb ${DEBIAN_MIRROR}/debian bookworm-updates main contrib non-free non-free-firmware" \
        "deb ${DEBIAN_MIRROR}/debian-security bookworm-security main contrib non-free non-free-firmware" \
        > /etc/apt/sources.list; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libx11-6 \
        libxcb1 \
        libx11-xcb1 \
        libxcb-render0 \
        libxcb-shm0 \
        libxcb-shape0 \
        libxcb-xfixes0 \
        libxcb-randr0 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-icccm4 \
        libxcb-sync1 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libfontconfig1 \
        libdbus-1-3 \
    && ldconfig \
    && find /usr -name 'libxcb.so.1' -print \
    && test -n "$(find /usr -name 'libxcb.so.1' -print -quit)" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./


RUN set -eux; \
    pip install --upgrade pip; \
    pip install -r requirements.txt; \
    python -c "import cv2; print('cv2-ok', cv2.__version__)"

COPY app ./app
COPY --from=frontend-build /frontend/dist ./frontend/dist

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
