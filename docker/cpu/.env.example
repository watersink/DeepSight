# DeepSight CPU 机环境变量模板
# cp .env.example .env 后，主机相关地址只改下面「主机地址」一节即可
# docker compose 会自动读取本目录 .env，无需改 docker-compose.yml

TZ=Asia/Shanghai
LOG_LEVEL=INFO

# ========== 主机地址（只改这里）==========
# CPU 机对外 IP/域名（浏览器、播流、MinIO 直链）
PUBLIC_HOST=10.1.3.21
# GPU 机 IP（API 调度 Worker / 可选 Triton）
GPU_HOST=10.1.3.21
# ========================================

# ----- 对外端口 -----
API_PUBLISH_PORT=8000
MYSQL_PUBLISH_PORT=3306
REDIS_PUBLISH_PORT=6379
RABBITMQ_PUBLISH_PORT=5672
RABBITMQ_MGMT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ZLM_RTMP_PUBLISH_PORT=1935
ZLM_HTTP_PUBLISH_PORT=8080
ZLM_RTSP_PUBLISH_PORT=8554
WORKER_PUBLISH_PORT=8100
TRITON_GRPC_PORT=8201

# ----- MySQL -----
MYSQL_USER=deepsight
MYSQL_PASSWORD=deepsight
MYSQL_DB=yingjiting

# ----- Redis -----
REDIS_DB=1
REDIS_PASSWORD=
REDIS_ENABLED=true

# ----- RabbitMQ（本项目 RABBITMQ_*）-----
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

# ----- MinIO -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=yingjiting

# ----- ZLMediaKit（须与 conf/zlm/config.ini [api] secret 一致）-----
ZLM_SECRET=b1CXeSHhB1AcYV5Hmf9e9h7nyHXsI9Tm

# ----- GPU Worker -----
# 默认由 GPU_HOST + WORKER_PUBLISH_PORT 自动拼装；多卡时取消注释并手写整行：
# WORKER_NODES=gpu1|GPU-1|http://10.1.3.21:8100;gpu2|GPU-2|http://10.1.3.22:8100
DEFAULT_WORKER_ID=gpu1
WORKER_TOKEN=change-me

# 构建镜像用国内源
DEBIAN_MIRROR=https://mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
NPM_REGISTRY=https://registry.npmmirror.com
