# DeepSight GPU 机环境变量模板
# cp .env.example .env 后，主机相关地址只改下面「主机地址」一节即可
# docker compose 会自动读取本目录 .env，无需改 docker-compose.yml

TZ=Asia/Shanghai
LOG_LEVEL=INFO

# ========== 主机地址（只改这里）==========
# CPU 机局域网 IP（推流 / MinIO / MQ / MySQL / Redis 都指向它）
# 须与 CPU 机 docker/cpu/.env 里的 PUBLIC_HOST 一致
CPU_HOST=10.1.3.21
# ========================================

# 与 CPU 机 WORKER_TOKEN 保持一致
WORKER_TOKEN=change-me
WORKER_PUBLISH_PORT=8100

# Triton
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.06-py3
TRITON_MODELS_HOST_PATH=./volumes/triton/models
TRITON_HTTP_PORT=8200
TRITON_GRPC_PORT=8201
TRITON_METRICS_PORT=8202
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0
NVIDIA_DEVICE_COUNT=1

# 与 CPU 机中间件账号一致
MYSQL_PORT=3306
MYSQL_USER=deepsight
MYSQL_PASSWORD=deepsight
MYSQL_DB=yingjiting

REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_ENABLED=true

RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=yingjiting

ZLM_HTTP_PORT=8080
ZLM_RTMP_PORT=1935
ZLM_RTSP_PORT=8554
ZLM_SECRET=b1CXeSHhB1AcYV5Hmf9e9h7nyHXsI9Tm

STREAM_USE_HARDWARE_ENCODING=true
STREAM_USE_HARDWARE_DECODING=true

# 构建镜像用国内源
DEBIAN_MIRROR=https://mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
