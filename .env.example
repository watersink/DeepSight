# DeepSight API 环境变量模板
# 复制为 .env 后填写实际值：cp .env.example .env
# 注意：.env 含密钥等敏感信息，请勿提交到代码仓库

# ---------- ZLMediaKit 流媒体引擎 ----------
ZLM_HOST=10.1.3.21
ZLM_RTMP_PORT=1935
ZLM_RTSP_PORT=8554
ZLM_HTTP_PORT=8080
ZLM_SECRET=请填写与 ZLMediaKit config.ini [api] secret 一致的密钥

# ---------- Worker 节点 ----------
WORKER_NODES=localw|本机Worker|http://127.0.0.1:8100
#WORKER_NODES=localw|本机Worker|http://127.0.0.1:8100;gpu1|GPU-21|http://10.1.3.21:8100
DEFAULT_WORKER_ID=localw
WORKER_TOKEN=change-me

# ---------- Triton 推理地址 ----------
TRITON_URL=10.1.3.21:8201

# ---------- 煤安平台 OAuth2（获取 client_token）----------
COAL_OAUTH_TOKEN_URL=http://host:port/coal/oauth2/client_token
COAL_OAUTH_CLIENT_ID=请填写 client_id
COAL_OAUTH_CLIENT_SECRET=请填写 client_secret
COAL_OAUTH_SCOPE=请填写 scope

# ---------- 煤安平台：视频质量异常数据推送（POST /mine/ai/videoAnomaly）----------
COAL_VIDEO_ANOMALY_PUSH_ENABLED=true
COAL_VIDEO_ANOMALY_PUSH_URL=http://host:port/coal/mine/ai/videoAnomaly
COAL_VIDEO_ANOMALY_PUSH_TIMEOUT=30
# 证据图片在 MinIO 中的对象名前缀
COAL_VIDEO_ANOMALY_IMAGE_PREFIX=coal/video_anomaly
# mineCode 兜底（不传时取服务端全局配置 mine.mine-code）
#MINE_CODE=请填写12位煤矿编码
